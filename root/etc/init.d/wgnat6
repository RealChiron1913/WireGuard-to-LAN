#!/bin/sh /etc/rc.common
# Recover an unconfirmed generation before firewall (START=19) reads includes.
START=18
STOP=89
USE_PROCD=1

start_service() {
	local attempt=0 result=0
	while :; do
		/usr/sbin/wgnat6 boot
		result=$?
		[ "$result" -eq 0 ] && break
		[ "$result" -eq 75 ] || return "$result"
		attempt=$((attempt + 1))
		[ "$attempt" -lt 5 ] || return 75
		sleep 1
	done
	procd_open_instance
	procd_set_param command /usr/libexec/wgnat6/watchdog
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
